{
	"schemaVersion": 1,
	"id": "tatnatclient",
	"version": "${version}",
	"name": "tatnat client",
	"description": "The in-game side of the tatnat launcher: a Right Shift mod menu, a drag-and-drop HUD editor and PvP / quality-of-life mods.",
	"authors": [
		"tatnat"
	],
	"contact": {
		"homepage": "https://www.youtube.com/@tatnatmc"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/tatnatclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.tatnat.client.mc.Entry"
		]
	},
	"mixins": [
		{
			"config": "tatnatclient.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${minecraft_dependency}",
		"java": ">=8"
	}
}
